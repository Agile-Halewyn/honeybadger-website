# HoneyBadger website — optionele build-time variabelen (Astro)
# Kopieer naar .env lokaal; in Netlify: Site settings → Environment variables.
#
# Waitlist POST-endpoint (publiek; wordt ingebakken in de statische build).
PUBLIC_WAITLIST_API_URL=https://app.honeybadgertrader.com/api/waitlist
#
# Staging / preview (Netlify branch deploys): wijs naar staging-Flask, niet naar productie,
# zodat test-builds geen productiedata raken.
