---
import Base from '../layouts/Base.astro';
---

<Base title="Bedankt voor je aanmelding! — HoneyBadger Bots" description="Je inschrijving voor de early access is gelukt.">
  <section class="section success-section">
    <div class="container success-container">
      <div class="success-icon">&#x1F389;</div> <!-- Party popper emoji -->
      <h1>Je staat op de lijst!</h1>
      <p>
        Fantastisch dat je meedoet aan de early access van HoneyBadger Bots. We nemen zo snel mogelijk contact met je op via het opgegeven e-mailadres wanneer er een plekje voor je vrijkomt.
      </p>
      <a href="/" class="btn btn--primary btn--large mt-8">Terug naar home</a>
    </div>
  </section>
</Base>

<style>
  .success-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .success-container {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .success-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .success-container h1 {
    margin-bottom: 1rem;
  }

  .success-container p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .mt-8 {
    margin-top: 2rem;
  }
</style>
