---
import Base from '../../layouts/Base.astro';
---

<Base title="Bedankt voor je bericht — HoneyBadger Trader" description="Je contactbericht is ontvangen.">
  <section class="section success-section">
    <div class="container success-container">
      <div class="success-icon">&#x1F44B;</div>
      <h1>Bedankt voor je bericht!</h1>
      <p>We hebben je bericht goed ontvangen en reageren zo snel mogelijk per e-mail.</p>
      <a href="/" class="btn btn--primary btn--large mt-8">Terug naar home</a>
    </div>
  </section>
</Base>

<style>
  .success-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-container {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .success-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .success-container h1 {
    margin-bottom: 1rem;
  }

  .success-container p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .mt-8 {
    margin-top: 2rem;
  }
</style>
