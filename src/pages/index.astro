---
import Base from '../layouts/Base.astro';
---

<Base title="HoneyBadger Bots — Geautomatiseerd crypto traden">

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="badge">Nu in early access</span>
        <h1>Crypto trading bots die voor je werken</h1>
        <p class="hero__sub">
          Professionele handelsstrategieen, automatisch uitgevoerd op jouw Bitvavo account.
          Geen technische kennis nodig. Jij behoudt volledige controle.
        </p>
        <div class="hero__actions">
          <a href="/waitlist" class="btn btn--primary btn--large">Schrijf je in voor early access</a>
          <a href="/hoe-het-werkt" class="btn btn--secondary btn--large">Hoe het werkt</a>
        </div>
      </div>
      <!-- TODO: banner afbeelding toevoegen via <Image /> component -->
      <!-- <Image src={import('../assets/banner.png')} alt="HoneyBadger dashboard" widths={[640, 1024, 1600]} formats={['webp', 'avif']} /> -->
    </div>
  </section>

  <!-- Kernpunten -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__header">
        <h2>Waarom HoneyBadger?</h2>
        <p>Trading bots zijn krachtig, maar tot nu toe alleen toegankelijk voor techneuten. Wij veranderen dat.</p>
      </div>
      <div class="grid-3">
        <div class="card">
          <div class="card__icon">&#x1F916;</div>
          <h3>Volledig geautomatiseerd</h3>
          <p>Onze bots handelen 24/7 op basis van bewezen strategieen. DCA, grid trading en meer — zonder dat jij iets hoeft te doen.</p>
        </div>
        <div class="card">
          <div class="card__icon">&#x1F512;</div>
          <h3>Jij houdt de controle</h3>
          <p>Je crypto blijft op jouw eigen Bitvavo account. Wij krijgen alleen handelsrechten, nooit opnamerechten.</p>
        </div>
        <div class="card">
          <div class="card__icon">&#x1F4CA;</div>
          <h3>Volledig transparant</h3>
          <p>Elke trade is zichtbaar in je persoonlijke dashboard. Geen verborgen kosten, geen ondoorzichtige strategieen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hoe het werkt (kort) -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>In drie stappen aan de slag</h2>
      </div>
      <div class="grid-3">
        <div class="step">
          <span class="step__number">1</span>
          <h3>Account aanmaken</h3>
          <p>Registreer en koppel je Bitvavo account via een beveiligde API-sleutel (alleen handelsrechten).</p>
        </div>
        <div class="step">
          <span class="step__number">2</span>
          <h3>Strategie kiezen</h3>
          <p>Selecteer een strategie die past bij jouw risicoprofiel en bepaal hoeveel kapitaal je wilt inzetten.</p>
        </div>
        <div class="step">
          <span class="step__number">3</span>
          <h3>Bot activeert</h3>
          <p>De bot begint automatisch met handelen. Volg alles live via je dashboard en pas instellingen aan wanneer je wilt.</p>
        </div>
      </div>
      <div class="section__footer">
        <a href="/hoe-het-werkt" class="btn btn--secondary">Meer over hoe het werkt</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt">
    <div class="container cta">
      <h2>Klaar om te beginnen?</h2>
      <p>Schrijf je in voor early access en wees een van de eersten die HoneyBadger uitprobeert.</p>
      <a href="/waitlist" class="btn btn--primary btn--large">Schrijf je in</a>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
  }

  .hero__content {
    max-width: 640px;
  }

  .hero__content h1 {
    margin-top: 1rem;
  }

  .hero__sub {
    margin-top: 1.25rem;
    font-size: 1.1875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .card__icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .step {
    text-align: center;
  }

  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .step h3 {
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    max-width: 300px;
    margin: 0 auto;
  }

  .section__footer {
    text-align: center;
    margin-top: 2.5rem;
  }

  .cta {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }

  .cta p {
    color: var(--color-text-muted);
    margin: 1rem 0 2rem;
    font-size: 1.125rem;
  }
</style>
