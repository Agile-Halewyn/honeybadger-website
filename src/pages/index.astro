---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../config';
import { defaultDescription } from '../i18n/ui';
---

<Base title="HoneyBadger Trader" description={defaultDescription.nl} lang="nl">
  <section class="section">
    <div class="container neutral">
      <h1>HoneyBadger Trader</h1>
      <p>HoneyBadger Trader is in ontwikkeling. Er wordt op dit moment geen dienst aangeboden.</p>
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>
  </section>
</Base>

<style>
  .neutral {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 0;
  }

  .neutral p {
    margin-top: 1rem;
    font-size: 1.125rem;
  }
</style>
