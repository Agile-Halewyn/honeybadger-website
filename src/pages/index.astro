---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
---

<Base title="HoneyBadger Trader — Geautomatiseerd crypto handelen met tradingbots">

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="badge">Nu in early access</span>
        <h1>Automatiseer je crypto handelen zonder de controle te verliezen</h1>
        <p class="hero__sub">
          Met HoneyBadger Trader laat je tradingbots 24/7 voor je werken, ook als je nieuw bent in crypto. Koppel eenmalig je Bitvavo account, kies een strategie en behoud altijd controle over je eigen tegoeden.
        </p>
        <p class="hero__pricing-note">Vanaf &euro;5 per strategie per maand &mdash; plus 8% op winst.</p>
        <div class="hero__actions">
          <a href="/waitlist" class="btn btn--primary btn--large">Schrijf je in voor early access</a>
          <a href="/hoe-het-werkt" class="btn btn--secondary">Hoe het werkt &rarr;</a>
        </div>
      </div>
      <Image src={import('../assets/banner.png')} alt="HoneyBadger Trader dashboard overzicht" widths={[640, 1024, 1600]} />
    </div>
  </section>

  <!-- Kernpunten -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__header">
        <h2>Waarom HoneyBadger?</h2>
        <p>Tradingbots waren lang vooral voor techneuten of grote fondsen. Wij maken geautomatiseerd crypto handelen toegankelijk voor iedereen.</p>
      </div>
      <div class="grid-3">
        <div class="card">
          <div class="card__icon">&#x1F916;</div>
          <h3>Handelt 24/7 voor jou</h3>
          <p>Profiteer dag en nacht van marktbewegingen met geautomatiseerde handelsstrategieën. Terwijl jij slaapt, blijft de bot waakzaam.</p>
        </div>
        <div class="card">
          <div class="card__icon">&#x1F512;</div>
          <h3>Jouw geld, jouw regels</h3>
          <p>Je crypto staat en blijft veilig op je eigen Bitvavo account. Via API-sleutels krijgen wij enkel handelsrechten, nooit toestemming om op te nemen.</p>
        </div>
        <div class="card">
          <div class="card__icon">&#x1F4F1;</div>
          <h3>Zowel simpel als pro</h3>
          <p>Start direct en simpel via een strak, intuïtief dashboard. Liever diep in de data duiken? Voor de analist is er een geavanceerde view vol met gedetailleerde grafieken en handelsstatistieken.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hoe het werkt (kort) -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>Binnen 3 stappen aan de slag</h2>
      </div>
      <div class="grid-3">
        <div class="step">
          <span class="step__number">1</span>
          <h3>Koppel je account</h3>
          <p>Maak een HoneyBadger Trader account aan en verbind je Bitvavo account veilig via een exclusieve API-sleutel.</p>
        </div>
        <div class="step">
          <span class="step__number">2</span>
          <h3>Kies & configureer</h3>
          <p>Selecteer een professionele bot, bepaal met welke inleg hij mag werken en stel eventuele eigen limieten in. Lees meer over onze <a href="/strategieen">strategieën</a>.</p>
        </div>
        <div class="step">
          <span class="step__number">3</span>
          <h3>Activeer & volg live</h3>
          <p>Geef je bot de 'Go' en leun achterover. Monitor alle trades en het rendement eenvoudig via je persoonlijke dashboard.</p>
        </div>
      </div>
      <div class="section__footer">
        <a href="/hoe-het-werkt" class="btn btn--secondary">Meer over hoe het werkt</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt">
    <div class="container cta">
      <h2>Klaar om te beginnen?</h2>
      <p>Schrijf je in voor early access en wees een van de eersten die HoneyBadger Trader uitprobeert.</p>
      <a href="/waitlist" class="btn btn--primary btn--large">Schrijf je in</a>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4rem;
  }

  .hero__content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hero__content h1 {
    margin-top: 1rem;
  }

  .hero__sub {
    margin-top: 1.25rem;
    font-size: 1.1875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .hero__pricing-note {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .card__icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .step {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 960px) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 24px;
      left: 60%;
      right: -40%;
      height: 2px;
      background-color: var(--color-border);
      z-index: -1;
    }
  }

  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .step h3 {
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    max-width: 300px;
    margin: 0 auto;
  }

  .section__footer {
    text-align: center;
    margin-top: 2.5rem;
  }

  .cta {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }

  .cta p {
    color: var(--color-text-muted);
    margin: 1rem 0 2rem;
    font-size: 1.125rem;
  }
</style>
