---
import Base from '../../layouts/Base.astro';
import { getAlternateUrls } from '../../i18n/utils';
import type { Locale } from '../../i18n/routes';
import { CONTACT_EMAIL } from '../../config';

interface Props {
  locale: Locale;
  title: string;
  routeKey?: 'terms' | 'disclaimer';
}

const { locale, title, routeKey = 'terms' } = Astro.props;
const contactMailto = `mailto:${CONTACT_EMAIL}`;
const alternates = getAlternateUrls(routeKey);

const text: Record<Locale, { before: string }> = {
  nl: { before: 'Deze pagina is tijdelijk niet beschikbaar. Vragen: ' },
  en: { before: 'This page is temporarily unavailable. Questions: ' },
  es: { before: 'Esta página no está disponible temporalmente. Preguntas: ' },
};
const description = `${text[locale].before}${CONTACT_EMAIL}`;
---

<Base title={title} description={description} lang={locale} alternateUrls={alternates}>
  <div class="legal">
    <p>{text[locale].before}<a href={contactMailto}>{CONTACT_EMAIL}</a></p>
  </div>
</Base>
