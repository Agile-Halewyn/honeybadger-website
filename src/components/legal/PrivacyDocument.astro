---
import Base from '../../layouts/Base.astro';
import { getAlternateUrls } from '../../i18n/utils';
import type { Locale } from '../../i18n/routes';
import { privacyContent } from '../../i18n/legal/privacy';
import { PRIVACY_EMAIL } from '../../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = privacyContent[locale];
const privacyMailto = `mailto:${PRIVACY_EMAIL}`;
const alternates = getAlternateUrls('privacy');
---

<Base
  title={content.title}
  description={content.metaDescription}
  lang={locale}
  alternateUrls={alternates}
>
  <div class="legal">
    <h1>{content.h1}</h1>
    <p class="last-updated">{content.lastUpdated}</p>
    <p><strong>{content.noticeLabel}</strong> {content.notice}</p>

    {content.sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.intro && <p>{section.intro}</p>}
        {section.paragraphs?.map((p) => (
          p.html ? <p set:html={p.html.replace('{privacyEmail}', PRIVACY_EMAIL).replace('{privacyMailto}', privacyMailto)} /> : <p>{p.text}</p>
        ))}
        {section.list && (
          <ul>
            {section.list.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}
      </>
    ))}
  </div>
</Base>
