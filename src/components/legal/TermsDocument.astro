---
import OfflineNotice from './OfflineNotice.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const titles: Record<Locale, string> = {
  nl: 'Voorwaarden — HoneyBadger Trader',
  en: 'Terms — HoneyBadger Trader',
  es: 'Condiciones — HoneyBadger Trader',
};
---

<OfflineNotice locale={locale} title={titles[locale]} routeKey="terms" />
