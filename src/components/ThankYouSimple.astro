---
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/routes';
import { getAlternateUrls, getLocalizedPath } from '../i18n/utils';
import { getUi } from '../i18n/ui';
import type { ThankYouPageContent } from '../i18n/pages/types';

interface Props {
  locale: Locale;
  content: ThankYouPageContent;
  routeKey?: 'bedankt' | 'contactThankYou' | 'waitlistThankYou';
}

const { locale, content, routeKey = 'bedankt' } = Astro.props;
const ui = getUi(locale);
const homePath = getLocalizedPath('home', locale);
const alternates = getAlternateUrls(routeKey);
---

<Base
  title={content.title}
  description={content.description}
  lang={locale}
  alternateUrls={alternates}
>
  <section class="section success-section">
    <div class="container success-container">
      <div class="success-icon">{content.icon}</div>
      <h1>{content.heading}</h1>
      <p>{content.intro}</p>
      <a href={homePath} class="btn btn--primary btn--large mt-8">{ui.common.backToHome}</a>
    </div>
  </section>
</Base>

<style>
  .success-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-container {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .success-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .success-container h1 {
    margin-bottom: 1rem;
  }

  .success-container p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .mt-8 {
    margin-top: 2rem;
  }
</style>
