---
import { BITVAVO_AFFILIATE_URL } from '../config';
import type { Locale } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  collapsible?: boolean;
  defaultOpen?: boolean;
  locale?: Locale;
}

const { collapsible = false, defaultOpen = false, locale = 'nl' } = Astro.props;
const affiliate = getUi(locale).affiliate;
---

<aside class="bitvavo-affiliate" aria-label={affiliate.heading}>
  {collapsible ? (
    <details class="bitvavo-affiliate__details" open={defaultOpen}>
      <summary class="bitvavo-affiliate__summary">{affiliate.summary}</summary>
      <div class="bitvavo-affiliate__content">
        <p>
          {affiliate.body} {affiliate.disclosure}
        </p>
        <p class="bitvavo-affiliate__promo">{affiliate.promo}</p>
        <a
          href={BITVAVO_AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="btn btn--secondary"
        >
          {affiliate.cta}
        </a>
        <p class="bitvavo-affiliate__disclaimer">
          {affiliate.disclaimer}
        </p>
      </div>
    </details>
  ) : (
    <>
      <h3>{affiliate.heading}</h3>
      <p>
        {affiliate.body} {affiliate.disclosure}
      </p>
      <p class="bitvavo-affiliate__promo">{affiliate.promo}</p>
      <a
        href={BITVAVO_AFFILIATE_URL}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="btn btn--secondary"
      >
        {affiliate.cta}
      </a>
      <p class="bitvavo-affiliate__disclaimer">
        {affiliate.disclaimer}
      </p>
    </>
  )}
</aside>

<style>
  .bitvavo-affiliate {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    max-width: 480px;
    margin: 0 auto;
    width: 100%;
    text-align: center;
  }

  .bitvavo-affiliate h3 {
    margin-bottom: 0.75rem;
  }

  .bitvavo-affiliate__details {
    text-align: left;
  }

  .bitvavo-affiliate__summary {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    text-align: center;
  }

  .bitvavo-affiliate__summary::-webkit-details-marker {
    display: none;
  }

  .bitvavo-affiliate__summary::after {
    content: ' +';
    color: var(--color-text-muted);
  }

  .bitvavo-affiliate__details[open] .bitvavo-affiliate__summary::after {
    content: ' −';
  }

  .bitvavo-affiliate__content {
    margin-top: 0.75rem;
    text-align: center;
  }

  .bitvavo-affiliate p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .bitvavo-affiliate .btn {
    margin-top: 1rem;
  }

  .bitvavo-affiliate__promo {
    font-size: 0.9375rem;
  }

  .bitvavo-affiliate__disclaimer {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
</style>
