---
import type { Locale } from '../i18n/routes';
import { getLocalizedPath } from '../i18n/utils';
import { getUi } from '../i18n/ui';
import { Image } from 'astro:assets';
import hbLogo from '../assets/hb-logo.png';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'nl';
const ui = getUi(locale);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: getLocalizedPath('home', locale), label: ui.nav.home },
  { href: getLocalizedPath('howItWorks', locale), label: ui.nav.howItWorks },
  { href: getLocalizedPath('strategies', locale), label: ui.nav.strategies },
  { href: getLocalizedPath('pricing', locale), label: ui.nav.pricing },
  { href: getLocalizedPath('faq', locale), label: ui.nav.faq },
  { href: getLocalizedPath('contact', locale), label: ui.nav.contact },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={getLocalizedPath('home', locale)} class="header__logo">
      <Image src={hbLogo} alt="HoneyBadger Trader" width={32} height={32} class="header__logo-icon" style={{ borderRadius: '4px' }} />
      <span class="header__logo-text">HoneyBadger<span class="header__logo-accent">Trader</span></span>
    </a>

    <nav class="nav">
      <button class="nav__toggle" aria-label={ui.nav.menu} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav__menu">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['nav__link', { 'nav__link--active': currentPath === item.href || currentPath === item.href.replace(/\/$/, '') }]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav__cta">
          <a href={getLocalizedPath('waitlist', locale)} class="btn btn--primary">{ui.nav.earlyAccess}</a>
        </li>
        <li>
          <LanguageSwitcher locale={locale} currentPath={currentPath} />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .header__logo:hover { text-decoration: none; }

  .header__logo-icon { font-size: 1.5rem; }

  .header__logo-accent { color: var(--color-primary-hover); }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav__link {
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--color-text);
    background: var(--color-bg-alt);
    text-decoration: none;
  }

  .nav__link--active {
    color: var(--color-text);
  }

  .nav__cta { margin-left: 0.75rem; }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s;
  }

  /* keep in sync with LanguageSwitcher.astro mobile breakpoint */
  @media (max-width: 1089px) {
    .nav__toggle { display: flex; }

    .nav__menu {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 1.5rem;
      gap: 0.25rem;
      box-shadow: var(--shadow-lg);
    }

    .nav__menu--open { display: flex; }

    .nav__link {
      padding: 0.75rem;
      width: 100%;
    }

    .nav__cta {
      margin-left: 0;
      margin-top: 0.5rem;
      width: 100%;
    }

    .nav__cta .btn { width: 100%; justify-content: center; }
  }
</style>
