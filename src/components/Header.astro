---
import type { Locale } from '../i18n/routes';
import { getLocalizedPath } from '../i18n/utils';
import { getUi } from '../i18n/ui';
import { Image } from 'astro:assets';
import hbLogo from '../assets/hb-logo.png';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'nl';
const ui = getUi(locale);
const currentPath = Astro.url.pathname;

---

<header class="header">
  <div class="container header__inner">
    <a href={getLocalizedPath('home', locale)} class="header__logo">
      <Image src={hbLogo} alt="HoneyBadger Trader" width={32} height={32} class="header__logo-icon" style={{ borderRadius: '4px' }} />
      <span class="header__logo-text">HoneyBadger<span class="header__logo-accent">Trader</span></span>
    </a>

    <LanguageSwitcher locale={locale} currentPath={currentPath} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .header__logo:hover { text-decoration: none; }

  .header__logo-icon { font-size: 1.5rem; }

  .header__logo-accent { color: var(--color-primary-hover); }

</style>
