---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../i18n/routes';
import { contactContent } from '../../i18n/pages/contact';
import { getAlternateUrls, getLocalizedPath } from '../../i18n/utils';
import { getPathPlaceholders, interpolatePaths } from '../../i18n/pages/helpers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = contactContent[locale];
const paths = getPathPlaceholders(locale);
const alternates = getAlternateUrls('contact');
const thankYouPath = getLocalizedPath('contactThankYou', locale);
const privacyHtml = interpolatePaths(content.form.privacyHtml, paths);
---

<Base
  title={content.title}
  description={content.description}
  lang={locale}
  alternateUrls={alternates}
>
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h1>{content.h1}</h1>
        <p>{content.intro}</p>
      </div>

      <div class="contact-form-wrapper">
        <form
          name="contact"
          method="POST"
          action={thankYouPath}
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>{content.form.honeypotLabel} <input name="bot-field" /></label>
          </p>

          <div class="form-group">
            <label for="name">{content.form.nameLabel}</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder={content.form.namePlaceholder}
              required
            />
          </div>

          <div class="form-group">
            <label for="email">{content.form.emailLabel}</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={content.form.emailPlaceholder}
              required
            />
          </div>

          <div class="form-group">
            <label for="subject">{content.form.subjectLabel}</label>
            <select id="subject" name="subject" required>
              <option value="">{content.form.subjectPlaceholder}</option>
              {content.form.subjectOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="message">{content.form.messageLabel}</label>
            <textarea
              id="message"
              name="message"
              placeholder={content.form.messagePlaceholder}
              minlength="20"
              required
            />
          </div>

          <button type="submit" class="btn btn--primary btn--large contact-form__submit">
            {content.form.submit}
          </button>

          <p class="form-privacy" set:html={privacyHtml} />
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-form-wrapper {
    max-width: 640px;
    margin: 0 auto;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form__submit {
    width: 100%;
    justify-content: center;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 1rem;
    font-family: inherit;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 160px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .form-privacy {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .contact-form-wrapper {
      padding: 1.25rem;
    }
  }
</style>
