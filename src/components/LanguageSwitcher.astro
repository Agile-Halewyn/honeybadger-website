---
import type { Locale } from '../i18n/routes';
import { getLanguageSwitcherUrls } from '../i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const switcherUrls = getLanguageSwitcherUrls(currentPath);
const labels: Record<Locale, string> = { nl: 'NL', es: 'ES', en: 'EN' };
---

<nav class="lang-switcher" aria-label="Language">
  {(Object.keys(labels) as Locale[]).map((code) => (
    <a
      href={switcherUrls[code]}
      class:list={['lang-switcher__link', { 'lang-switcher__link--active': code === locale }]}
      hreflang={code}
      lang={code}
    >
      {labels[code]}
    </a>
  ))}
</nav>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
  }

  .lang-switcher__link {
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .lang-switcher__link:hover {
    color: var(--color-text);
    background: var(--color-bg-alt);
    text-decoration: none;
  }

  .lang-switcher__link--active {
    color: var(--color-accent);
    background: var(--color-primary-light);
  }

  @media (max-width: 768px) {
    .lang-switcher {
      margin-left: 0;
      margin-top: 0.5rem;
      justify-content: center;
      width: 100%;
    }
  }
</style>
