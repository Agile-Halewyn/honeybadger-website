---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Locale } from '../i18n/routes';
import { getOgLocale } from '../i18n/routes';
import { defaultDescription } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  ogLocale?: string;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  lang = 'nl',
  ogLocale = getOgLocale(lang),
  alternateUrls,
} = Astro.props;

const metaDescription = description ?? defaultDescription[lang];
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://honeybadgertrader.com';

const hreflangEntries = alternateUrls
  ? (Object.entries(alternateUrls) as [Locale, string][]).map(([locale, path]) => ({
      locale,
      href: `${site}${path}`,
    }))
  : [];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#f59e0b" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale} />

  {hreflangEntries.map(({ locale, href }) => (
    <link rel="alternate" hreflang={locale} href={href} />
  ))}
  {alternateUrls?.nl && (
    <link rel="alternate" hreflang="x-default" href={`${site}${alternateUrls.nl}`} />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Plausible Analytics — actief; data-domain moet overeenkomen met Plausible-dashboard -->
  <script defer data-domain="honeybadgertrader.com" src="https://plausible.io/js/script.js"></script>
</head>
<body>
  <Header locale={lang} />
  <main>
    <slot />
  </main>
  <Footer locale={lang} />

  <slot name="body-scripts" />

  <script defer src="/js/nav-toggle.js"></script>
</body>
</html>
